<resources>
    <!-- Base application theme -->
    <style name="Theme.AppaVoid" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your app theme here -->
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:colorBackground">@color/charcoal_black</item>
    </style>

    <!-- Lock Screen Theme -->
    <style name="Theme.AppaVoid.LockScreen" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Fullscreen style for LockScreenActivity -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- Custom style for 3D effect buttons -->
    <style name="App3DButton" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:elevation">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:padding">8dp</item>
    </style>
</resources>
